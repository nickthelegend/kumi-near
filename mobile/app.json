{
  "expo": {
    "name": "Kumi",
    "slug": "kumi-near",
    "version": "0.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "kumi",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFF4E6",
    "splash": {
      "image": "./assets/splash.jpg",
      "resizeMode": "cover",
      "backgroundColor": "#3B1F4A"
    },
    "ios": {
      "bundleIdentifier": "xyz.kumi.near",
      "supportsTablet": false
    },
    "android": {
      "package": "xyz.kumi.near",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#3B1F4A"
      },
      "permissions": [
        "CAMERA",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Kumi",
      "backgroundColor": "#FFF4E6",
      "themeColor": "#3B1F4A",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-image",
      [
        "expo-camera",
        {
          "cameraPermission": "Kumi scans chat invite QR codes."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FF6F59"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Kumi reads an invite QR from a photo you pick."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    }
  }
}
