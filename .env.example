# Copy to .env (gitignored). Names only; never commit values.
# Relayer / owner account. Its key lives in .near-credentials/<account>.json (gitignored).
KUMI_RELAYER_ACCOUNT=
# Optional: path to that key file, relative to the repo root.
KUMI_RELAYER_CREDENTIALS=
# The hub contract (set by pnpm deploy:testnet).
KUMI_HUB=
NEAR_RPC_URL=https://test.rpc.fastnear.com
# Optional: a separate provider for reads (the app's RPC proxy), e.g. https://near-testnet.drpc.org
KUMI_READ_RPC_URL=
# Testnet NEAR gifted to each new player so they can join a crew.
KUMI_GIFT_NEAR=0.2
KUMI_SERVER_PORT=15196
# Email delivery for sign-in codes. Without it the app shows "Setup required: RESEND_API_KEY".
RESEND_API_KEY=
KUMI_EMAIL_FROM=
# Mainnet NEAR Intents: live 1Click swaps need a funded account. Without it, quotes are dry: true only.
NEAR_MAINNET_ACCOUNT=
# Optional 1Click partner JWT: lowers the fee and enables confidential (private) quotes.
ONECLICK_JWT=
# Web: read a different hub than the recorded deployment.
VITE_KUMI_HUB=
